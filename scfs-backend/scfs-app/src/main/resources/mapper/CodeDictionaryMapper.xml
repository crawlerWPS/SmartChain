<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scfs.common.mapper.CodeDictionaryMapper">

    <resultMap id="CodeDictionaryResultMap" type="com.scfs.common.entity.CodeDictionary">
        <id column="id" property="id"/>
        <result column="code_type" property="codeType"/>
        <result column="code_key" property="codeKey"/>
        <result column="code_value" property="codeValue"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectEnabled" resultMap="CodeDictionaryResultMap">
        SELECT *
        FROM schema_common.code_dictionary
        WHERE status = 1
        <if test="codeType != null and codeType != ''">
            AND code_type = #{codeType}
        </if>
        ORDER BY code_type, sort_order, id
    </select>

    <select id="selectByKey" resultMap="CodeDictionaryResultMap">
        SELECT * FROM schema_common.code_dictionary WHERE code_key = #{codeKey}
    </select>

    <select id="selectTypes" resultType="string">
        SELECT DISTINCT code_type
        FROM schema_common.code_dictionary
        WHERE status = 1
        ORDER BY code_type
    </select>

</mapper>
