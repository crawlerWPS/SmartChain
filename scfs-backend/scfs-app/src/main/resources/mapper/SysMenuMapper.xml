<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scfs.common.mapper.SysMenuMapper">

    <resultMap id="MenuResultMap" type="com.scfs.common.entity.SysMenu">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_code" property="menuCode"/>
        <result column="menu_type" property="menuType"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="permission" property="permission"/>
        <result column="icon" property="icon"/>
        <result column="sort" property="sort"/>
        <result column="visible" property="visible"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectById" resultMap="MenuResultMap">
        SELECT * FROM schema_common.sys_menu WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="MenuResultMap">
        SELECT * FROM schema_common.sys_menu WHERE menu_code = #{menuCode}
    </select>

    <select id="selectAll" resultMap="MenuResultMap">
        SELECT * FROM schema_common.sys_menu WHERE status = 1 ORDER BY sort ASC
    </select>

    <select id="selectAllTree" resultMap="MenuResultMap">
        SELECT * FROM schema_common.sys_menu ORDER BY parent_id, sort ASC
    </select>

    <select id="selectMenuIdsByRoleId" resultType="long">
        SELECT menu_id FROM schema_common.sys_role_menu WHERE role_id = #{roleId}
    </select>

    <select id="selectMenusByRoleId" resultMap="MenuResultMap">
        SELECT m.* FROM schema_common.sys_menu m
        INNER JOIN schema_common.sys_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id = #{roleId} AND m.status = 1
        ORDER BY m.parent_id, m.sort ASC
    </select>

    <insert id="insert" parameterType="com.scfs.common.entity.SysMenu" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO schema_common.sys_menu (parent_id, menu_name, menu_code, menu_type, path, component,
            permission, icon, sort, visible, status)
        VALUES (#{parentId}, #{menuName}, #{menuCode}, #{menuType}, #{path}, #{component},
            #{permission}, #{icon}, #{sort}, COALESCE(#{visible}, 1), COALESCE(#{status}, 1))
    </insert>

    <update id="update" parameterType="com.scfs.common.entity.SysMenu">
        UPDATE schema_common.sys_menu
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="menuName != null">menu_name = #{menuName},</if>
            <if test="path != null">path = #{path},</if>
            <if test="component != null">component = #{component},</if>
            <if test="permission != null">permission = #{permission},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="visible != null">visible = #{visible},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM schema_common.sys_menu WHERE id = #{id}
    </delete>

    <insert id="insertRoleMenu" parameterType="com.scfs.common.entity.SysRoleMenu">
        INSERT INTO schema_common.sys_role_menu (role_id, menu_id) VALUES (#{roleId}, #{menuId})
        ON CONFLICT (role_id, menu_id) DO NOTHING
    </insert>

    <delete id="deleteRoleMenuByRoleId">
        DELETE FROM schema_common.sys_role_menu WHERE role_id = #{roleId}
    </delete>

</mapper>
